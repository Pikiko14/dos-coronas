      <i lista="dragon_brasas,24"/>
    </monstruos>
    <tinte lista="1,0.8,0.7"/>
  </mazmorra>
  <mazmorra id="mz3" nombre="Santuario del Eclipse" desc="El templo donde la luz se apaga. Liches, ojos del abismo y el Behemot de guerra." nivelMin="25" continente="1">
    <biomas lista="eclipse,velo,cienaga,pinar"/>
    <jefe nombre="Behemot del Eclipse" nivel="30" dano="1.3" monstruo="behemot" vida="4"/>
