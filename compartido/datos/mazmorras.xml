  <mazmorra id="mz1" nombre="Cripta del Olvido" desc="Un osario bajo la colina. Esqueletos, momias, espíritus y un rey envuelto en vendas que no descansa." nivelMin="10" continente="1">
    <biomas lista="colina,senda,campos,bosque"/>
    <jefe nombre="Rey Momia" nivel="17" dano="1.7" monstruo="jefe_rey_momia" vida="9"/>
    <monstruos>
      <i lista="esqueleto,13"/>
      <i lista="esqueleto_soldado,14"/>
      <i lista="espiritu_velo,13"/>
      <i lista="momia,14"/>
    </monstruos>
    <tinte lista="0.8,0.85,1"/>
  </mazmorra>
  <mazmorra id="mz2" nombre="Foso de las Brasas" desc="Galerías de escoria al rojo vivo. Ogros, diablillos, elementales de brasas y un diablo que despierta con el calor." nivelMin="18" continente="2">
