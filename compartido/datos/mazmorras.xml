  <mazmorra id="mz1" nombre="Cripta del Olvido" desc="Un osario bajo la colina. Esqueletos, espectros y un caballero que no descansa." nivelMin="10" continente="1">
    <biomas lista="colina,senda,campos,bosque"/>
    <jefe nombre="Señor de la Cripta" nivel="17" dano="1.7" monstruo="caballero" vida="9"/>
    <monstruos>
      <i lista="esqueleto,13"/>
      <i lista="espectro,12"/>
      <i lista="gargola,14"/>
      <i lista="alma,13"/>
    </monstruos>
    <tinte lista="0.8,0.85,1"/>
  </mazmorra>
  <mazmorra id="mz2" nombre="Foso de las Brasas" desc="Galerías de escoria al rojo vivo. Gólems, demonios y un titán que despierta con el calor." nivelMin="18" continente="2">
