      <i lista="ojo_abismo,28"/>
      <i lista="liche,28"/>
      <i lista="demonio_rey,29"/>
      <i lista="hidra_ceniza,29"/>
    </monstruos>
    <tinte lista="0.85,0.75,1"/>
  </mazmorra>
