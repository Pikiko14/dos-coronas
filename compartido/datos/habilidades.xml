    <mago lista="misil,fuego,escudo,nova,rayo_hielo,meteoro,rayo_arcano,lluvia_fuego,teletransporte,torbellino"/>
    <lancero lista="estocada,barrido,muro_lanzas,embestida,jabalina,tormenta_lanzas,fisura_del_lancero,pulso_terrestre,torbellino_lanzas,juicio_final"/>
