<?xml version="1.0" encoding="UTF-8"?>
<!--
  Poderes de cada clase.
  tipo: enemigo | alrededor | propio | punto | suelo | aliado | aliados | mixto | buff_alrededor.
  cd = enfriamiento (s); mana; coef = potencia; rango y aoe en casillas; proyectil: misil, fuego, flecha, sagrado, sombra.
  estado: lo que aplica al golpear (tipo, prob, dur, pct).
-->
<habilidades>
  <!-- ---- guerrero ---- -->
  <habilidad id="golpe" nombre="Golpe" clase="guerrero" tipo="enemigo" cd="1.5" coef="1.10" desc="Un golpe firme con el arma." mana="10" rango="1.45">
    <estado tipo="sangrar" prob="0.12"/>
  </habilidad>
  <habilidad id="tajo" nombre="Tajo" clase="guerrero" tipo="alrededor" cd="7" coef="1.8" desc="Golpea a todos los enemigos cercanos." mana="14" rango="2.5">
    <estado tipo="sangrar" prob="0.3"/>
  </habilidad>
  <habilidad id="grito" nombre="Grito de guerra" clase="guerrero" tipo="buff_alrededor" buff="grito" cd="16" desc="Aumenta el ataque de los aliados cercanos." dur="8" mana="18" rango="4.5"/>
  <habilidad id="carga" nombre="Carga" clase="guerrero" tipo="enemigo" aturde="0.8" cd="11" coef="0.75" dash="true" desc="Te lanzas al objetivo y lo aturdes un instante." mana="12" rango="5.5"/>
  <habilidad id="desgarro" nombre="Desgarro" clase="guerrero" tipo="enemigo" cd="9" coef="1.6" desc="Un tajo profundo que abre una herida." mana="20" rango="1.45">
    <estado tipo="sangrar" dur="6" prob="0.85"/>
  </habilidad>
  <habilidad id="furia" nombre="Furia" clase="guerrero" tipo="propio" buff="furia" cd="32" desc="Tu ataque crece mucho durante un rato." dur="10" mana="28">
    <efecto atk="0.3"/>
  </habilidad>
  <!-- ---- mago ---- -->
  <habilidad id="misil" nombre="Misil arcano" clase="mago" tipo="enemigo" cd="1" coef="1.25" dano="magico" desc="Un dardo de energía." mana="8" proyectil="misil" rango="7.2">
    <estado tipo="lentitud" dur="2" pct="0.3" prob="0.12"/>
  </habilidad>
  <habilidad id="fuego" nombre="Bola de fuego" clase="mago" tipo="enemigo" aoe="1.8" cd="3" coef="1.55" dano="magico" desc="Estalla al impactar." mana="24" proyectil="fuego" rango="7.2">
    <estado tipo="quemar" prob="0.3"/>
  </habilidad>
  <habilidad id="escudo" nombre="Escudo arcano" clase="mago" tipo="propio" buff="escudo" cd="14" desc="Absorbe parte del daño." dur="8" mana="20"/>
  <habilidad id="nova" nombre="Nova de hielo" clase="mago" tipo="alrededor" cd="10" coef="1.4" dano="magico" desc="Hiela y ralentiza alrededor." lentitud="0.45" mana="50" rango="3.8"/>
  <habilidad id="sombra" nombre="Descarga de sombras" clase="mago" tipo="enemigo" cd="6" coef="1.2" dano="magico" desc="Una descarga oscura que drena vida." mana="26" proyectil="sombra" rango="7">
    <estado tipo="drenar_vida" prob="0.9"/>
  </habilidad>
  <habilidad id="meteoro" nombre="Meteoro" clase="mago" tipo="punto" aoe="2.6" cd="22" coef="2.3" dano="magico" desc="Una roca en llamas cae sobre la zona." mana="45" rango="8">
    <estado tipo="quemar" dur="5" prob="0.6"/>
  </habilidad>
  <!-- ---- cazador ---- -->
  <habilidad id="disparo" nombre="Disparo" clase="cazador" tipo="enemigo" cd="1.05" coef="1.15" desc="Una flecha rápida." mana="6" proyectil="flecha" rango="7.4">
    <estado tipo="sangrar" prob="0.12"/>
  </habilidad>
  <habilidad id="lluvia" nombre="Lluvia de flechas" clase="cazador" tipo="punto" aoe="2.2" cd="8" coef="1.3" desc="Flechas sobre una zona." mana="22" rango="7.4">
    <estado tipo="lentitud" dur="3" pct="0.35" prob="0.25"/>
  </habilidad>
  <habilidad id="trampa" nombre="Trampa" clase="cazador" tipo="suelo" cd="14" desc="Inmoviliza al primer enemigo que la pisa." mana="16" rango="1.2"/>
  <habilidad id="preciso" nombre="Tiro preciso" clase="cazador" tipo="enemigo" cd="8" coef="2.05" desc="Un disparo devastador." mana="18" proyectil="flecha" rango="8.2">
    <estado tipo="sangrar" dur="6" prob="0.4"/>
  </habilidad>
  <habilidad id="flecha_veneno" nombre="Flecha envenenada" clase="cazador" tipo="enemigo" cd="7" coef="1" desc="Una flecha untada que envenena." mana="16" proyectil="flecha" rango="7.4">
    <estado tipo="veneno" dur="7" prob="1"/>
  </habilidad>
  <habilidad id="paso_agil" nombre="Paso ágil" clase="cazador" tipo="propio" buff="agil" cd="18" desc="Corres mucho más rápido un momento." dur="5" mana="14">
    <efecto vel="0.5"/>
  </habilidad>
  <!-- ---- clerigo ---- -->
  <habilidad id="curar" nombre="Curación" clase="clerigo" tipo="aliado" cd="2.1" cura="28" curaN="5" desc="Restaura vida a un aliado o a ti." mana="16" rango="6.5"/>
  <habilidad id="bendicion" nombre="Rayo bendito" clase="clerigo" tipo="enemigo" cd="4" coef="1.5" dano="magico" desc="Un rayo bendito que hiere al enemigo. Se aprende al nivel 5." mana="16" proyectil="sagrado" rango="6.4"/>
  <habilidad id="castigo" nombre="Castigo" clase="clerigo" tipo="enemigo" cd="1.35" coef="1.12" dano="magico" desc="Luz que hiere. El clérigo también ataca." mana="10" proyectil="sagrado" rango="6.4">
    <estado tipo="quemar" prob="0.2"/>
  </habilidad>
  <habilidad id="consagrar" nombre="Consagración" clase="clerigo" tipo="mixto" cd="10" coef="1.5" cura="18" curaN="2" dano="magico" desc="Daña enemigos y cura aliados a tu alrededor." mana="28" rango="2.8">
    <estado tipo="aturdir" dur="1" prob="0.15"/>
  </habilidad>
  <habilidad id="sanacion" nombre="Luz sanadora" clase="clerigo" tipo="aliados" cd="15" cura="22" curaN="4" desc="Cura a todos los aliados cercanos." mana="38" rango="4.5"/>
  <habilidad id="juicio" nombre="Juicio divino" clase="clerigo" tipo="enemigo" aturde="1.2" cd="16" coef="2.3" dano="magico" desc="Un haz de luz que hiere y aturde." mana="34" proyectil="sagrado" rango="6.4"/>
  <!-- ---- orden de los poderes en la barra (teclas 1 a 6) ---- -->
  <barra>
    <cazador lista="disparo,lluvia,trampa,preciso,flecha_veneno,paso_agil"/>
    <clerigo lista="curar,bendicion,castigo,consagrar,sanacion,juicio"/>
    <guerrero lista="golpe,tajo,grito,carga,desgarro,furia"/>
    <mago lista="misil,fuego,escudo,nova,sombra,meteoro"/>
  </barra>
</habilidades>
