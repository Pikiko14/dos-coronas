<?xml version="1.0" encoding="UTF-8"?>
<!--
  Poderes de cada clase.
  tipo: enemigo | alrededor | propio | punto | suelo | aliado | aliados | mixto | buff_alrededor | invocar.
  invocar: esbirro = id de esbirros.xml, cantidad y dur (segundos); lo que pegan sale del ataque mágico de quien invoca.
  cd = enfriamiento (s); mana; coef = potencia; rango y aoe en casillas; proyectil: misil, fuego, flecha, sagrado, sombra.
  estado: lo que aplica al golpear (tipo, prob, dur, pct).
-->
<habilidades>
  <!-- guerrero -->
