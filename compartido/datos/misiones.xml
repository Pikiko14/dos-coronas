<!--
  Misiones curadas: los encargos de cada ciudad y las CADENAS con premios. Además el juego genera solo (compartido/dominio/misiones.lua)
  una misión de cazar por cada criatura (normales, élites y jefes), otra de repetición, trofeos que recolectar y entregas entre las
  ciudades y los puestos del mapa.

  tipo: cazar (por defecto) | recolectar | entregar.
  npc: quién la da (c_<ciudad> es el tablón de encargos de una ciudad; ver ciudades.xml). ciudad="x" equivale a npc="c_x".
  destino: a quién se entrega (por defecto, el mismo que la da). Las entregas llevan paquete="nombre del objeto".
  monstruo / de: criatura a cazar o que suelta el trofeo. cantidad, nivel (el de la misión: sube con él la recompensa).
  dif: normal | dificil | epica (cuánto pesa en la recompensa y qué margen de nivel se admite). factor: multiplicador extra (finales de cadena).
  oro / xp: si se escriben, mandan; si no, salen de la fórmula de misiones.lua (cantidad x criatura x dificultad).
  requiere: misión que hay que haber entregado antes. siguiente: misión que se acepta sola al entregar esta (si la da el mismo PNJ).
  Premios especiales (los difíciles; no todo se regala): premios="objeto:cantidad,objeto:cantidad", addon="skin_...", montura="id", monedas="n".
-->
<misiones>
  <!-- ======================= Encargos de cada ciudad (los de siempre) ======================= -->
  <mision id="q_auroria" ciudad="auroria" monstruo="seta_azul" cantidad="6" nivel="1" dialogo="Esas setas no dejan en paz el granero. Derrota seis." texto="Las setas azules se han vuelto bravas. Derrota 6." titulo="Setas en el granero" siguiente="q_auroria_2"/>
  <mision id="q_auroria_2" ciudad="auroria" monstruo="calabaza" cantidad="4" nivel="1" requiere="q_auroria" dialogo="El huerto sigue inquieto. Acaba con cuatro calabazas más." texto="Quedan calabazas entre la paja. Derrota 4." titulo="El huerto inquieto"/>
  <mision id="q_puerto_sol" ciudad="puerto_sol" monstruo="pinguino_aprendiz" cantidad="8" nivel="3" texto="Los pingüinos aprendices enredan las redes. Derrota 8." titulo="Pingüinos de muelle"/>
  <mision id="q_liria" ciudad="liria" monstruo="larva_verde" cantidad="6" nivel="3" texto="Derrota 6 larvas verdes al sur de Liria." titulo="Larvas en la senda"/>
  <mision id="q_henar" ciudad="henar" monstruo="duende_bruma" cantidad="8" nivel="5" texto="Derrota 8 duendes de la bruma." titulo="Duendes del trigo"/>
  <mision id="q_alba" ciudad="alba" monstruo="espantapajaros" cantidad="8" nivel="2" texto="Derrota 8 espantapájaros vivos." titulo="Espantapájaros del bastión"/>
  <mision id="q_nocturnia" ciudad="nocturnia" monstruo="murcielago_purpura" cantidad="6" nivel="10" texto="Derrota 6 murciélagos púrpura." titulo="Murciélagos del velo"/>
  <mision id="q_puerto_sombra" ciudad="puerto_sombra" monstruo="cangrejo_espinoso" cantidad="5" nivel="17" texto="Derrota 5 cangrejos espinosos." titulo="Cangrejos de la marea"/>
  <mision id="q_nox" ciudad="nox" monstruo="libelula_cian" cantidad="6" nivel="6" texto="Derrota 6 libélulas cian." titulo="Libélulas de Nox"/>
  <mision id="q_velo" ciudad="velo" monstruo="polilla_rosa" cantidad="6" nivel="8" texto="Derrota 6 polillas rosas." titulo="Polillas de la ciénaga"/>
  <mision id="q_eclipse" ciudad="eclipse" monstruo="girasol_lancero" cantidad="5" nivel="10" texto="Derrota 5 girasoles lanceros." titulo="Girasoles del eclipse"/>

  <!-- ======================= Cadena A (Albor): El camino del explorador. Premio: addon Explorador ======================= -->
  <mision id="ca_1" npc="c_liria" tipo="recolectar" de="larva_verde" cantidad="6" nivel="3" titulo="Seda para el curtidor"
    dialogo="Un explorador me encargó un mapa nuevo, y el curtidor pide seda de larva para la tinta. Tráeme seis." texto="Reúne 6 trofeos de larva verde." final="Con esto el curtidor tendrá para semanas."/>
  <mision id="ca_2" npc="c_liria" tipo="entregar" paquete="Mapa del explorador" destino="c_henar" nivel="5" requiere="ca_1" titulo="El mapa del explorador"
    dialogo="El mapa está listo. Llévaselo al explorador en Henar, él sabrá qué hacer." texto="Lleva el mapa a Henar." final="¡El mapa! Por fin sabré por dónde seguir."/>
  <mision id="ca_3" npc="c_henar" monstruo="escarabajo_dorado" cantidad="12" nivel="5" requiere="ca_2" titulo="Despejar los trigales" siguiente="ca_4"
    dialogo="El mapa marca los trigales. Antes de seguir hay que quitar de en medio a los escarabajos dorados." texto="Derrota 12 escarabajos dorados."/>
  <mision id="ca_4" npc="c_henar" monstruo="rabano_guerrero" cantidad="10" nivel="9" dif="dificil" requiere="ca_3" titulo="Rábanos de las colinas" siguiente="ca_5"
    dialogo="Más allá hay rábanos guerreros. Parecen graciosos, pero cortan: ve con cuidado." texto="Derrota 10 rábanos guerreros."/>
  <mision id="ca_5" npc="c_henar" monstruo="ogro_palido" cantidad="8" nivel="12" dif="dificil" factor="1.8" requiere="ca_4" titulo="El camino del explorador"
    premios="polvo_arcano:20,pocion_vida_mediana:10" addon="skin_explorador"
    dialogo="Solo queda la banda de ogros que guarda el paso. Derrótala y el camino será tuyo, y mi ropa de viaje también." texto="Derrota 8 ogros pálidos." final="Eres un explorador de los buenos. Quédate con mi atuendo."/>

  <!-- ======================= Cadena B (Albor): La corona del Alba. Premio: addon Rey ======================= -->
  <mision id="cb_1" npc="c_alba" monstruo="lancero_dorado" cantidad="15" nivel="16" dif="dificil" titulo="Lanceros sin señor" siguiente="cb_2"
    dialogo="Los lanceros dorados vagan sin señor. La corona del Alba te necesita: empieza por ellos." texto="Derrota 15 lanceros dorados."/>
  <mision id="cb_2" npc="c_alba" tipo="recolectar" de="esqueleto" cantidad="10" nivel="15" dif="dificil" requiere="cb_1" titulo="Huesos del linaje"
    dialogo="Necesito huesos de los esqueletos errantes para el ritual del linaje." texto="Reúne 10 trofeos de esqueleto errante." final="Con estos huesos podré cerrar la herida."/>
  <mision id="cb_3" npc="c_alba" tipo="entregar" paquete="Sello real" destino="c_auroria" nivel="15" requiere="cb_2" titulo="El sello real"
    dialogo="Lleva este sello al tablón de Auroria. Allí sabrán quién eres." texto="Lleva el sello real a Auroria." final="El sello es auténtico. Ahora hablemos de lo que viene."/>
  <mision id="cb_4" npc="c_auroria" monstruo="anquilosaurio" cantidad="12" nivel="19" dif="dificil" requiere="cb_3" titulo="Lagartos del reino" siguiente="cb_5"
    dialogo="Los lagartos acorazados asolan las fronteras. Un heredero debe saber defender su reino." texto="Derrota 12 lagartos acorazados."/>
  <mision id="cb_5" npc="c_auroria" monstruo="bestia_cornuda" cantidad="6" nivel="21" dif="dificil" requiere="cb_4" titulo="Bestias cornudas" siguiente="cb_6"
    dialogo="Las bestias cornudas de los pinares. Sin ellas, el reino respira." texto="Derrota 6 bestias cornudas."/>
  <mision id="cb_6" npc="c_auroria" monstruo="cangrejo_loto" cantidad="4" nivel="24" dif="epica" factor="2" requiere="cb_5" titulo="La corona del Alba"
    premios="polvo_arcano:60,pocion_vida_grande:15" monedas="80" addon="skin_rey"
    dialogo="Los cangrejos de loto son la última prueba. Si caen cuatro, la corona es tuya." texto="Derrota 4 cangrejos de loto." final="Viva el nuevo rey. Que la corona del Alba te sirva."/>

  <!-- ======================= Cadena C (Umbra): El señor del Ocaso. Premio: addon Caballero oscuro ======================= -->
  <mision id="cc_1" npc="c_eclipse" monstruo="diablillo_azul" cantidad="12" nivel="13" dif="dificil" titulo="Diablillos del Ocaso" siguiente="cc_2"
    dialogo="Los diablillos hablan de un señor que nunca vino. El Ocaso necesita a alguien que acabe con ellos." texto="Derrota 12 diablillos azules."/>
  <mision id="cc_2" npc="c_eclipse" tipo="recolectar" de="medusa_violeta" cantidad="10" nivel="16" dif="dificil" requiere="cc_1" titulo="Tentáculos del velo"
    dialogo="El ritual pide tentáculos de medusas violeta. Reúne diez." texto="Reúne 10 trofeos de medusa violeta." final="Frío como el vacío. Perfecto."/>
  <mision id="cc_3" npc="c_eclipse" tipo="entregar" paquete="Sello oscuro" destino="c_velo" nivel="16" requiere="cc_2" titulo="El sello oscuro"
    dialogo="Entrega el sello oscuro a la ciénaga del Velo. Ellos custodian la armadura." texto="Lleva el sello oscuro a la ciénaga del Velo." final="Sí, es el sello. La armadura espera."/>
  <mision id="cc_4" npc="c_velo" monstruo="dama_velo" cantidad="10" nivel="18" dif="dificil" requiere="cc_3" titulo="Damas del velo" siguiente="cc_5"
    dialogo="Las damas del velo guardan el último fragmento. Hay que arrancárselo." texto="Derrota 10 damas del velo."/>
  <mision id="cc_5" npc="c_velo" monstruo="calamar_espectral" cantidad="8" nivel="22" dif="dificil" requiere="cc_4" titulo="Calamares de la marea" siguiente="cc_6"
    dialogo="De la marea salen calamares cada noche. Quien los detenga merece la armadura." texto="Derrota 8 calamares espectrales."/>
  <mision id="cc_6" npc="c_velo" monstruo="elemental_brasas" cantidad="4" nivel="27" dif="epica" factor="2" requiere="cc_5" titulo="El señor del Ocaso"
    premios="polvo_arcano:60,pocion_vida_grande:15" monedas="80" addon="skin_caballero_oscuro"
    dialogo="El elemental de brasas es el último obstáculo. Acaba con él cuatro veces y la armadura negra será tuya." texto="Derrota 4 elementales de brasas." final="La noche reconoce a su señor."/>

  <!-- ======================= Cadena D (Umbra): Jinete de la tormenta. Premio: montura Toro del trueno ======================= -->
  <mision id="cd_1" npc="c_nox" monstruo="tortuga_espinosa" cantidad="12" nivel="16" dif="dificil" titulo="Tortugas de la ciénaga" siguiente="cd_2"
    dialogo="El toro del trueno no se deja domar por cualquiera. Demuéstralo: empieza por las tortugas espinosas." texto="Derrota 12 tortugas espinosas."/>
  <mision id="cd_2" npc="c_nox" tipo="recolectar" de="medusa_guerrera" cantidad="10" nivel="20" dif="dificil" requiere="cd_1" titulo="Descargas de medusa"
    dialogo="Necesito la energía de las medusas guerreras para calmar al animal. Diez trofeos." texto="Reúne 10 trofeos de medusa guerrera." final="Estos trofeos aún chispean."/>
  <mision id="cd_3" npc="c_nox" monstruo="tortuga_coral" cantidad="6" nivel="21" dif="dificil" requiere="cd_2" titulo="La prueba de las tortugas" siguiente="cd_4"
    dialogo="Quien monta al toro debe ser capaz de enfrentarse a una tortuga de coral." texto="Derrota 6 tortugas de coral."/>
  <mision id="cd_4" npc="c_nox" monstruo="bestia_espectral" cantidad="5" nivel="25" dif="epica" requiere="cd_3" titulo="Bestias espectrales" siguiente="cd_5"
    dialogo="Las bestias espectrales son la última criba antes de la tormenta." texto="Derrota 5 bestias espectrales."/>
  <mision id="cd_5" npc="c_nox" monstruo="troll_escarcha" cantidad="3" nivel="26" dif="epica" factor="2" requiere="cd_4" titulo="Jinete de la tormenta"
    premios="polvo_arcano:40,pocion_mana_grande:15" monedas="40" montura="mnt_027"
    dialogo="Tres trolls de escarcha. Si sobrevives, el toro del trueno te aceptará como jinete." texto="Derrota 3 trolls de escarcha." final="El toro te reconoce. Es tuyo."/>

  <!-- ======================= Cadena E (Albor): El corcel dorado. Premio: montura Corcel de fuego ======================= -->
  <mision id="ce_1" npc="c_puerto_sol" monstruo="arana_azul" cantidad="12" nivel="17" dif="dificil" titulo="Arañas de la costa" siguiente="ce_2"
    dialogo="Un corcel dorado pasta en las colinas del Alba, pero la costa está llena de arañas. Limpia primero la orilla." texto="Derrota 12 arañas azules."/>
  <mision id="ce_2" npc="c_puerto_sol" tipo="recolectar" de="ogro_hacha" cantidad="10" nivel="19" dif="dificil" requiere="ce_1" titulo="Pieles de ogro"
    dialogo="Para ganarte la confianza del corcel necesitas ropa que huela a victoria. Diez trofeos de ogro." texto="Reúne 10 trofeos de ogro del hacha." final="Servirán para el arnés."/>
  <mision id="ce_3" npc="c_puerto_sol" monstruo="golem_trepador" cantidad="10" nivel="18" dif="dificil" requiere="ce_2" titulo="Gólems de los pinos" siguiente="ce_4"
    dialogo="Los gólems trepadores rompen los pastos. Deshazte de ellos." texto="Derrota 10 gólems trepadores."/>
  <mision id="ce_4" npc="c_puerto_sol" monstruo="diablillo_lancero" cantidad="4" nivel="26" dif="epica" requiere="ce_3" titulo="Diablillos lanceros" siguiente="ce_5"
    dialogo="Los diablillos lanceros guardan el último pasto. Sin ellos, el corcel baja." texto="Derrota 4 diablillos lanceros."/>
  <mision id="ce_5" npc="c_puerto_sol" monstruo="reina_espejos" cantidad="2" nivel="29" dif="epica" factor="2" requiere="ce_4" titulo="El corcel dorado"
    premios="polvo_arcano:40,pocion_vida_grande:15" monedas="40" montura="mnt_008"
    dialogo="La reina de los espejos es el ama de esa tierra. Derrótala dos veces y el corcel dorado será tuyo." texto="Derrota 2 reinas de los espejos." final="El corcel baja a tu encuentro. Cuídalo bien."/>
</misiones>
