# Configuración del servidor de Dos Coronas.
# Copia este archivo como .env y cambia lo que necesites.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
# No subas tu .env a un repositorio: puede llevar claves.

# ---- Servidor ---------------------------------------------------------
# Puerto en el que escucha el servidor. El juego debe usar el mismo.
DOSCORONAS_PUERTO=30555

# Segundos entre guardados generales de todos los jugadores conectados (600 = 10 min).
# Aparte de esto, cada jugador se guarda al instante cuando se desconecta o cierra el juego.
DOSCORONAS_GUARDADO_SEGUNDOS=600

# Segundos entre reintentos si el almacén falla al guardar.
DOSCORONAS_REINTENTO_SEGUNDOS=5

# Mensajes por segundo que acepta el servidor de cada conexión.
DOSCORONAS_TASA_MENSAJES=40

# Estados del mundo que el servidor manda a cada cliente por segundo.
DOSCORONAS_FOTOS_POR_SEGUNDO=15

# ---- Cuentas y personajes ----------------------------------------------
# auto     = PostgreSQL si responde y, si no, el archivo cuentas.json
# postgres = solo PostgreSQL (el servidor avisa si no responde)
# archivo  = solo cuentas.json, en la carpeta de guardado de LÖVE
DOSCORONAS_ALMACEN=auto

DOSCORONAS_PG_HOST=127.0.0.1
DOSCORONAS_PG_PORT=5433
DOSCORONAS_PG_USER=doscoronas
DOSCORONAS_PG_DB=doscoronas
# Solo para autenticación "password" de PostgreSQL (md5 y scram no están soportados).
DOSCORONAS_PG_PASSWORD=
