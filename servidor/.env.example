# Configuración del servidor de Dos Coronas.
# Copia este archivo como .env y cambia lo que necesites.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
# No subas tu .env a un repositorio: puede llevar claves.

# ---- Servidor ---------------------------------------------------------
# Puerto en el que escucha el servidor. El juego debe usar el mismo.
DOSCORONAS_PUERTO=30555

# Segundos entre guardados generales de todos los jugadores conectados (600 = 10 min).
# Aparte de esto, cada jugador se guarda al instante cuando se desconecta o cierra el juego.
DOSCORONAS_GUARDADO_SEGUNDOS=600

# Segundos entre reintentos si el almacén falla al guardar.
DOSCORONAS_REINTENTO_SEGUNDOS=5

# Mensajes por segundo que acepta el servidor de cada conexión.
DOSCORONAS_TASA_MENSAJES=40

# Estados del mundo que el servidor manda a cada cliente por segundo.
DOSCORONAS_FOTOS_POR_SEGUNDO=15

# ---- Cuentas y personajes ----------------------------------------------
# auto     = PostgreSQL si responde y, si no, el archivo cuentas.json
# postgres = solo PostgreSQL (el servidor avisa si no responde)
# archivo  = solo cuentas.json, en la carpeta de guardado de LÖVE
DOSCORONAS_ALMACEN=auto

DOSCORONAS_PG_HOST=127.0.0.1
DOSCORONAS_PG_PORT=5433
DOSCORONAS_PG_USER=doscoronas
DOSCORONAS_PG_DB=doscoronas
# Solo para autenticación "password" de PostgreSQL (md5 y scram no están soportados).
DOSCORONAS_PG_PASSWORD=

# ---- Eventos de guerra (los lanza el servidor) -----------------------------
# si = programados por el servidor; no = vuelven a empezar solos al juntarse jugadores.
DOSCORONAS_EVENTOS=si
# Captura del estandarte: cada N horas en punto (4 = 00, 04, 08, 12, 16 y 20 h).
DOSCORONAS_ESTANDARTE_CADA_HORAS=4
# Batalla por cristales: una vez al día a esta hora (hora del servidor).
DOSCORONAS_BATALLA_HORA=21
DOSCORONAS_BATALLA_MINUTO=0
# Minutos antes de cada evento en los que se avisa a todos y se abre la inscripción.
DOSCORONAS_EVENTOS_AVISO_MINUTOS=5

# ---- Ajustes del juego -------------------------------------------------------
# Jugadores por corona que hacen falta para que empiece un evento de guerra (minimo 1).
DOSCORONAS_EVENTO_MIN_JUGADORES=1
# Duracion de cada evento, en segundos.
DOSCORONAS_BATALLA_DURACION_SEG=300
DOSCORONAS_ESTANDARTE_DURACION_SEG=300

# Experiencia: 1 = normal, 2 = experiencia doble (x2), 3 = triple...
DOSCORONAS_XP_MULTIPLICADOR=1
# Al morir (en el mundo) los personajes de nivel MAYOR que este pierden experiencia...
DOSCORONAS_MUERTE_NIVEL_MIN=10
# ...esta fraccion de lo que pide su nivel actual (0.10 = 10%; 0 = nunca). No se baja de nivel.
DOSCORONAS_MUERTE_XP_PERDIDA=0.10
# Cuanto cuesta subir de nivel (1.8 = casi el doble que la curva base).
DOSCORONAS_XP_DIFICULTAD=1.8
# Vida y ataque de las criaturas respecto a la formula base, y diferencia de nivel (0.04 = 4% por nivel).
DOSCORONAS_MONSTRUO_VIDA=3.0
DOSCORONAS_MONSTRUO_ATAQUE=1.05
DOSCORONAS_DIFERENCIA_NIVEL=0.04
# Segundos que tardan en reaparecer las criaturas normales y las elite.
DOSCORONAS_RESPAWN_MONSTRUO_SEG=22
DOSCORONAS_RESPAWN_ELITE_SEG=90

# Subastas: comision al publicar, impuesto al vender, subastas por jugador, duraciones (horas),
# subida minima de cada puja y segundos extra si pujan al final.
DOSCORONAS_SUBASTA_COMISION=0.05
DOSCORONAS_SUBASTA_IMPUESTO=0.08
DOSCORONAS_SUBASTA_MAX_POR_JUGADOR=8
DOSCORONAS_SUBASTA_DURACIONES_HORAS=1,6,12,24
DOSCORONAS_SUBASTA_SUBIDA_MINIMA=0.05
DOSCORONAS_SUBASTA_TIEMPO_EXTRA_SEG=120

# Gremios: nivel y oro para fundarlos, miembros maximos, bono de experiencia por companero
# cerca y cuantos companeros cuentan.
DOSCORONAS_GREMIO_NIVEL_MINIMO=8
DOSCORONAS_GREMIO_COSTE=1500
DOSCORONAS_GREMIO_MAX_MIEMBROS=25
DOSCORONAS_GREMIO_BONO_XP=0.05
DOSCORONAS_GREMIO_TOPE_COMPANEROS=3

# Oficios y caravanas: segundos entre salidas de caravanas, caravanas a la vez, velocidad,
# coste de cambiar de oficio y segundos que busca la ley a un ladron (con exito / si falla).
DOSCORONAS_CARAVANA_INTERVALO_SEG=70
DOSCORONAS_CARAVANA_MAX=0
DOSCORONAS_CARAVANA_VELOCIDAD=2.4
DOSCORONAS_OFICIO_COSTE_CAMBIO=300
DOSCORONAS_LADRON_BUSCADO_SEG=240
DOSCORONAS_LADRON_BUSCADO_FALLO_SEG=120

# Mascotas: segundos que descansa una mascota caida antes de volver.
DOSCORONAS_MASCOTA_DESCANSO_SEG=30

# Grupos (party): miembros maximos (2 a 5), experiencia extra del grupo (0.10 = +10% sobre el
# total, que luego se reparte entre los miembros) y distancia maxima para repartir.
DOSCORONAS_GRUPO_MAX=5
DOSCORONAS_GRUPO_BONO_XP=0.10
DOSCORONAS_GRUPO_DISTANCIA=30
# Encuentros de grupo: criaturas party y gigantes que salen cerca de los grupos.
# si/no, segundos medios entre encuentros, duracion si nadie los derrota y maximo a la vez.
DOSCORONAS_ENCUENTROS_GRUPO=si
DOSCORONAS_ENCUENTRO_INTERVALO_SEG=150
DOSCORONAS_ENCUENTRO_DURACION_SEG=300
DOSCORONAS_ENCUENTRO_MAX=10

# ---- Administrador ----
# Cuentas (separadas por comas) que pueden usar los comandos /admin del chat: invocar criaturas,
# dar objetos, iniciar eventos, teletransportarse... (escribe /admin ayuda dentro del juego).
# Vacio = nadie es administrador.
DOSCORONAS_ADMIN_USUARIO=
# Si pones usuario y clave, el servidor crea esa cuenta al arrancar (si no existe). La clave solo se
# usa para crearla: cambiarla aqui despues no cambia la de una cuenta ya creada.
DOSCORONAS_ADMIN_CLAVE=
